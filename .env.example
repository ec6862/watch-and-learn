# Copy this file to .env (never commit .env).

# Postgres container settings, read by infra/docker-compose.yml.
# Only applied the first time the data volume is created.
POSTGRES_USER=wal
POSTGRES_PASSWORD=wal_dev_password
POSTGRES_DB=watch_and_learn
POSTGRES_PORT=5432

# Connection string for the NestJS API (used from Phase 2 onward).
# Keep it in sync with the values above.
DATABASE_URL=postgresql://wal:wal_dev_password@localhost:5432/watch_and_learn